# Apache / cPanel — React Router üçün SPA fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real fayl və qovluqlara toxunma
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qalan bütün URL-lər → index.html
  RewriteRule ^ index.html [L]
</IfModule>
